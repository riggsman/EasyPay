APP_NAME=EasyPay
APP_ENV=development
SECRET_KEY=change-me-in-production-use-long-random-string
CONFIG_ENCRYPTION_KEY=dedicated-fernet-key-for-provider-secrets
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_URL=mysql+pymysql://easypay:easypay@localhost:3306/easypay
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEFAULT_CURRENCY=XAF
CAMPAY_BASE_URL=https://demo.campay.net/api
CAMPAY_MOCK=true
NOTIFICATIONS_SMS_ENABLED=false
